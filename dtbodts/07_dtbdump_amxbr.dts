						hysteresis = <0x0>;
						phandle = <0xfd>;
						temperature = <0x1c138>;
						type = "passive";
					};

					trip2 {
						hysteresis = <0x0>;
						temperature = <0x23668>;
						type = "passive";
					};
				};
			};

			soc {
				polling-delay = <0x0>;
				polling-delay-passive = <0x64>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <0x30>;
				tracks-low;
				wake-capable-sensor;

				trips {

					soc-trip {
						hysteresis = <0x0>;
						phandle = <0x40>;
						temperature = <0x5>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x2>;
			#interrupt-cells = <0x4>;
			#size-cells = <0x0>;
			interrupt-controller;

			qcom,pm8150l@4 {
				#address-cells = <0x2>;
				#size-cells = <0x0>;
				compatible = "qcom,spmi-pmic";
				reg = <0x4 0x0>;

				adc_tm@3500 {
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					#thermal-sensor-cells = <0x1>;
					compatible = "qcom,adc-tm5";
					interrupt-names = "thr-int-en";
					interrupts = <0x4 0x35 0x0 0x1>;
					io-channels = <0x31 0x4e 0x31 0x4d 0x31 0x4f>;
					phandle = <0xc3>;
					reg = <0x3500 0x100>;

					img108mp@4d {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4d>;
					};

					img25mp@4f {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4f>;
					};

					skin_msm_therm@4e {
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
						reg = <0x4e>;
					};
				};

				bcl@3d00 {
					#thermal-sensor-cells = <0x1>;
					compatible = "qcom,bcl-v5";
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					interrupts = <0x4 0x3d 0x0 0x0 0x4 0x3d 0x1 0x0 0x4 0x3d 0x2 0x0>;
					phandle = <0x35>;
					reg = <0x3d00 0x100>;
				};

				clock-controller@5b00 {
					#clock-cells = <0x1>;
					clock-names = "xo";
					clock-output-names = "pm8150l_div_clk1";
					clocks = <0xffffffff 0x0>;
					compatible = "qcom,spmi-clkdiv";
					phandle = <0x103>;
					qcom,num-clkdivs = <0x1>;
					reg = <0x5b00 0x100>;
				};

				pinctrl@c000 {
					#gpio-cells = <0x2>;
					compatible = "qcom,spmi-gpio";
					gpio-controller;
					interrupt-names = "pm8150l_gpio1", "pm8150l_gpio3", "pm8150l_gpio4", "pm8150l_gpio5", "pm8150l_gpio6", "pm8150l_gpio7", "pm8150l_gpio8", "pm8150l_gpio10", "pm8150l_gpio11";
					interrupts = <0x4 0xc0 0x0 0x0 0x4 0xc2 0x0 0x0 0x4 0xc3 0x0 0x0 0x4 0xc4 0x0 0x0 0x4 0xc5 0x0 0x0 0x4 0xc6 0x0 0x0 0x4 0xc7 0x0 0x0 0x4 0xc9 0x0 0x0 0x4 0xca 0x0 0x0>;
					phandle = <0x1>;
					qcom,gpios-disallowed = <0x2 0x9 0xc>;
					reg = <0xc000 0xc00>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					phandle = <0x32>;
					reg = <0x100 0x100>;
				};

				qcom,temp-alarm@2400 {
					#thermal-sensor-cells = <0x0>;
					compatible = "qcom,spmi-temp-alarm";
					interrupts = <0x4 0x24 0x0 0x3>;
					io-channel-names = "thermal";
					io-channels = <0x31 0x6>;
					phandle = <0x34>;
					qcom,temperature-threshold-set = <0x1>;
					reg = <0x2400 0x100>;
				};

				vadc@3100 {
					#address-cells = <0x1>;
					#io-channel-cells = <0x1>;
					#size-cells = <0x0>;
					compatible = "qcom,spmi-adc5";
					interrupt-names = "eoc-int-en-set";
					interrupts = <0x4 0x31 0x0 0x1>;
					io-channel-ranges;
					phandle = <0x31>;
					qcom,adc-vdd-reference = <0x753>;
					reg = <0x3100 0x100>;

					die_temp@2 {
						label = "die_temp";
						qcom,pre-scaling = <0x1 0x1>;
						reg = <0x6>;
					};

					img108mp@4d {
						label = "img108mp_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,ratiometric;
						reg = <0x4d>;
					};

					img25mp@4f {
						label = "img25mp_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,ratiometric;
						reg = <0x4f>;
					};

					ref_gnd@0 {
						label = "ref_gnd";
						qcom,pre-scaling = <0x1 0x1>;
						reg = <0x0>;
					};

					skin_msm_therm@4e {
						label = "skin_msm_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x1 0x1>;
						qcom,ratiometric;
						reg = <0x4e>;
					};

					vph_pwr@83 {
						label = "vph_pwr";
						qcom,pre-scaling = <0x1 0x3>;
						reg = <0x83>;
					};

					vref_1p25@1 {
						label = "vref_1p25";
						qcom,pre-scaling = <0x1 0x1>;
						reg = <0x1>;
					};
				};
			};

			qcom,pm8150l@5 {
				#address-cells = <0x2>;
				#size-cells = <0x0>;
				compatible = "qcom,spmi-pmic";
				reg = <0x5 0x0>;

				qcom,amoled {
					#address-cells = <0x1>;
					#size-cells = <0x1>;
					compatible = "qcom,qpnp-amoled-regulator";
					phandle = <0x119>;
					status = "ok";

					ab@de00 {
						phandle = <0x11b>;
						qcom,swire-control;
						reg = <0xde00 0x100>;
						reg-names = "ab_base";
						regulator-max-microvolt = <0x5d1420>;
						regulator-min-microvolt = <0x4630c0>;
						regulator-name = "ab";
					};

					ibb@dc00 {
						phandle = <0x11c>;
						qcom,swire-control;
						reg = <0xdc00 0x100>;
						reg-names = "ibb_base";
						regulator-max-microvolt = <0x5265c0>;
						regulator-min-microvolt = <0xc3500>;
						regulator-name = "ibb";
					};

					oledb@e000 {
						phandle = <0x11a>;
						qcom,swire-control;
						reg = <0xe000 0x100>;
						reg-names = "oledb_base";
						regulator-max-microvolt = <0x7b98a0>;
						regulator-min-microvolt = <0x4b2648>;
						regulator-name = "oledb";
					};
				};

				qcom,lcdb@ec00 {
					compatible = "qcom,qpnp-lcdb-regulator";
					interrupt-names = "sc-irq";
					interrupts = <0x5 0xec 0x1 0x1>;
					phandle = <0x104>;
					qcom,pmic-revid = <0x32>;
					qcom,voltage-step-ramp;
					reg = <0xec00 0x100>;
					status = "disabled";

					bst {
						label = "bst";
						phandle = <0x107>;
						regulator-max-microvolt = <0x5fbfb8>;
						regulator-min-microvolt = <0x47b760>;
						regulator-name = "lcdb_bst";
					};

					ldo {
						label = "ldo";
						phandle = <0x105>;
						regulator-max-microvolt = <0x5b8d80>;
						regulator-min-microvolt = <0x3d0900>;
						regulator-name = "lcdb_ldo";
					};

					ncp {
						label = "ncp";
						phandle = <0x106>;
						regulator-max-microvolt = <0x5b8d80>;
						regulator-min-microvolt = <0x3d0900>;
						regulator-name = "lcdb_ncp";
					};
				};

				qcom,leds@d000 {
					compatible = "qcom,tri-led";
					phandle = <0x118>;
					reg = <0xd000 0x100>;

					blue {
						label = "blue";
						led-sources = <0x2>;
						linux,default-trigger = "timer";
						pwms = <0x33 0x2 0xf4240>;
					};

					green {
						label = "green";
						led-sources = <0x1>;
						linux,default-trigger = "timer";
						pwms = <0x33 0x1 0xf4240>;
					};

					red {
						label = "red";
						led-sources = <0x0>;
						linux,default-trigger = "timer";
						pwms = <0x33 0x0 0xf4240>;
					};
				};

				qcom,leds@d300 {
					compatible = "qcom,qpnp-flash-led-v2";
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
					interrupts = <0x5 0xd3 0x0 0x1 0x5 0xd3 0x3 0x1 0x5 0xd3 0x4 0x1>;
					label = "flash";
					phandle = <0x108>;
					qcom,hdrm-auto-mode;
					qcom,isc-delay = <0xc0>;
					qcom,open-circuit-det;
					qcom,pmic-revid = <0x32>;
					qcom,short-circuit-det;
					qcom,thermal-derate-current = <0xc8 0x1f4 0x3e8>;
					qcom,thermal-derate-en;
					qcom,vph-droop-det;
					reg = <0xd300 0x100>;
					status = "okay";

					qcom,flash_0 {
						label = "flash";
						phandle = <0x109>;
						qcom,current-ma = <0x3e8>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,duration-ms = <0x500>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x0>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:flash_0";
						qcom,max-current = <0x5dc>;
					};

					qcom,flash_1 {
						label = "flash";
						phandle = <0x10a>;
						qcom,current-ma = <0x3e8>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,duration-ms = <0x500>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x1>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:flash_1";
						qcom,max-current = <0x5dc>;
					};

					qcom,flash_2 {
						label = "flash";
						phandle = <0x10b>;
						qcom,current-ma = <0x1f4>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,duration-ms = <0x500>;
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x2>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:flash_2";
						qcom,max-current = <0x2ee>;
						status = "disabled";
					};

					qcom,led_switch_0 {
						label = "switch";
						phandle = <0x10f>;
						qcom,default-led-trigger = "switch0_trigger";
						qcom,led-mask = <0x1>;
						qcom,led-name = "led:switch_0";
					};

					qcom,led_switch_1 {
						label = "switch";
						phandle = <0x110>;
						qcom,default-led-trigger = "switch1_trigger";
						qcom,led-mask = <0x2>;
						qcom,led-name = "led:switch_1";
					};

					qcom,led_switch_2 {
						label = "switch";
						phandle = <0x111>;
						qcom,default-led-trigger = "switch2_trigger";
						qcom,led-mask = <0x3>;
						qcom,led-name = "led:switch_2";
					};

					qcom,led_switch_3 {
						label = "switch";
						phandle = <0x112>;
						qcom,default-led-trigger = "switch3_trigger";
						qcom,led-mask = <0x4>;
						qcom,led-name = "led:switch_3";
					};

					qcom,torch_0 {
						label = "torch";
						phandle = <0x10c>;
						qcom,current-ma = <0x12c>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x0>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:torch_0";
						qcom,max-current = <0x1f4>;
					};

					qcom,torch_1 {
						label = "torch";
						phandle = <0x10d>;
						qcom,current-ma = <0x12c>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x1>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:torch_1";
						qcom,max-current = <0x1f4>;
					};

					qcom,torch_2 {
						label = "torch";
						phandle = <0x10e>;
						qcom,current-ma = <0x12c>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
						qcom,hdrm-voltage-mv = <0x145>;
						qcom,id = <0x2>;
						qcom,ires-ua = <0x30d4>;
						qcom,led-name = "led:torch_2";
						qcom,max-current = <0x1f4>;
						status = "disabled";
					};
				};

				qcom,pwms@b100 {
					#pwm-cells = <0x2>;
					compatible = "qcom,pwm-lpg";
					phandle = <0x33>;
					qcom,lut-patterns = <0x0 0xa 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0xa 0x0>;
					qcom,num-lpg-channels = <0x3>;
					reg = <0xb100 0x300 0xb000 0x100>;
					reg-names = "lpg-base", "lut-base";

					lpg1 {
						qcom,lpg-chan-id = <0x1>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-low-index = <0x0>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-pause-hi-count = <0x2>;
						qcom,ramp-pause-lo-count = <0x2>;
						qcom,ramp-step-ms = <0x64>;
					};

					lpg2 {
						qcom,lpg-chan-id = <0x2>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-low-index = <0x0>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-pause-hi-count = <0x2>;
						qcom,ramp-pause-lo-count = <0x2>;
						qcom,ramp-step-ms = <0x64>;
					};

					lpg3 {
						qcom,lpg-chan-id = <0x3>;
						qcom,ramp-from-low-to-high;
						qcom,ramp-high-index = <0x14>;
						qcom,ramp-low-index = <0x0>;
						qcom,ramp-pattern-repeat;
						qcom,ramp-pause-hi-count = <0x2>;
						qcom,ramp-pause-lo-count = <0x2>;
						qcom,ramp-step-ms = <0x64>;
					};
				};

				qcom,pwms@bc00 {
					#pwm-cells = <0x2>;
					compatible = "qcom,pwm-lpg";
					phandle = <0x117>;
					qcom,num-lpg-channels = <0x2>;
					reg = <0xbc00 0x200>;
					reg-names = "lpg-base";
				};

				qcom,wled@d800 {
					compatible = "qcom,pm8150l-spmi-wled";
					interrupt-names = "ovp-irq", "pre-flash-irq", "flash-irq";
					interrupts = <0x5 0xd8 0x1 0x1 0x5 0xd8 0x4 0x3 0x5 0xd8 0x5 0x3>;
					label = "backlight";
					phandle = <0x113>;
					qcom,auto-calibration;
					qcom,pmic-revid = <0x32>;
					reg = <0xd800 0x100 0xd900 0x100>;
					reg-names = "wled-ctrl-base", "wled-sink-base";
					status = "disabled";

					qcom,wled-flash {
						label = "flash";
						phandle = <0x114>;
						qcom,default-led-trigger = "wled_flash";
					};

					qcom,wled-switch {
						label = "switch";
						phandle = <0x116>;
						qcom,default-led-trigger = "wled_switch";
					};

					qcom,wled-torch {
						label = "torch";
						phandle = <0x115>;
						qcom,default-led-trigger = "wled_torch";
						qcom,wled-torch-timer = <0x4b0>;
					};
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			pm8150l-bcl-lvl0 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x64>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x35 0x5>;
				wake-capable-sensor;

				trips {

					l-bcl-lvl0 {
						hysteresis = <0x1>;
						phandle = <0x44>;
						temperature = <0x1>;
						type = "passive";
					};
				};
			};

			pm8150l-bcl-lvl1 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x64>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x35 0x6>;
				wake-capable-sensor;

				trips {

					l-bcl-lvl1 {
						hysteresis = <0x1>;
						phandle = <0x45>;
						temperature = <0x1>;
						type = "passive";
					};
				};
			};

			pm8150l-bcl-lvl2 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x64>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x35 0x7>;
				wake-capable-sensor;

				trips {

					l-bcl-lvl2 {
						hysteresis = <0x1>;
						phandle = <0x46>;
						temperature = <0x1>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl0 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x0>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <0x35 0x2>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph-lvl0 {
						hysteresis = <0xc8>;
						phandle = <0x11e>;
						temperature = <0xbb8>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl1 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x0>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <0x35 0x3>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph-lvl1 {
						hysteresis = <0xc8>;
						phandle = <0x11f>;
						temperature = <0xabe>;
						type = "passive";
					};
				};
			};

			pm8150l-vph-lvl2 {
				polling-delay = <0x0>;
				polling-delay-passive = <0x0>;
				thermal-governor = "low_limits_cap";
				thermal-sensors = <0x35 0x4>;
				tracks-low;
				wake-capable-sensor;

				trips {

					vph-lvl2 {
						hysteresis = <0xc8>;
						phandle = <0x120>;
						temperature = <0x9c4>;
						type = "passive";
					};
				};
			};

			pm8150l_tz {
				phandle = <0x11d>;
				polling-delay = <0x0>;
				polling-delay-passive = <0x64>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x34>;
				wake-capable-sensor;

				trips {

					trip0 {
						hysteresis = <0x0>;
						temperature = <0x17318>;
						type = "passive";
					};

					trip1 {
						hysteresis = <0x0>;
						temperature = <0x1c138>;
						type = "passive";
					};

					trip2 {
						hysteresis = <0x0>;
						temperature = <0x23668>;
						type = "passive";
					};
				};
			};
		};
	};
};
