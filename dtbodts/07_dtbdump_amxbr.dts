	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			cam_flash_en_default {
				phandle = <0x2>;

				config {
					drive-strength = <0x2>;
					output-low;
					pins = "gpio98";
				};

				mux {
					function = "gpio";
					pins = "gpio98";
				};
			};

			cam_sensor_mclk0_active {
				phandle = <0xa>;

				config {
					bias-disable;
					drive-strength = <0x6>;
					pins = "gpio94";
				};

				mux {
					function = "cam_mclk";
					pins = "gpio94";
				};
			};

			cam_sensor_mclk0_suspend {
				phandle = <0xb>;

				config {
					bias-pull-down;
					drive-strength = <0x2>;
					pins = "gpio94";
				};

				mux {
					function = "cam_mclk";
					pins = "gpio94";
				};
			};

			cam_sensor_mclk1_active {
				phandle = <0x1f>;

				config {
					bias-disable;
					drive-strength = <0x6>;
					pins = "gpio95";
