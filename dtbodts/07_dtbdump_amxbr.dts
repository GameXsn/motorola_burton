					interrupt-names = "pm8150_gpio1", "pm8150_gpio3", "pm8150_gpio6", "pm8150_gpio7", "pm8150_gpio9", "pm8150_gpio10";
					interrupts = <0x0 0xc0 0x0 0x0 0x0 0xc2 0x0 0x0 0x0 0xc5 0x0 0x0 0x0 0xc6 0x0 0x0 0x0 0xc8 0x0 0x0 0x0 0xc9 0x0 0x0>;
					phandle = <0xbe>;
					qcom,gpios-disallowed = <0x2 0x4 0x5 0x8>;
					reg = <0xc000 0xa00>;

					cdc_sleep_clk {

						cdc_sleep_clk_default {
							bias-disable;
							function = "func1";
							input-disable;
							output-low;
							phandle = <0xaf>;
							pins = "gpio3";
							power-source = <0x0>;
						};
					};

					imu_clkin {

						imu_clkin_default {
							bias-disable;
							function = "func1";
							output-low;
							phandle = <0xeb>;
							pins = "gpio3";
							power-source = <0x0>;
							qcom,drive-strength = <0x1>;
							qcom,dtest-buffer = <0x1>;
						};

						imu_clkin_sleep {
							bias-pull-down;
							function = "func1";
							input-enable;
							phandle = <0xec>;
							pins = "gpio3";
							power-source = <0x0>;
							qcom,drive-strength = <0x1>;
							qcom,dtest-buffer = <0x1>;
						};
					};

					key_confirm {

						key_confirm_default {
							bias-pull-up;
							function = "normal";
							input-enable;
							phandle = <0xed>;
							pins = "gpio7";
							power-source = <0x0>;
						};
					};

					key_home {

						key_home_default {
							bias-pull-up;
							function = "normal";
							input-enable;
							phandle = <0xea>;
							pins = "gpio1";
							power-source = <0x0>;
						};
					};

					key_vol_up {

